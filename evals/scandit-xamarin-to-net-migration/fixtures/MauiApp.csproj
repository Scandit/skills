<Project Sdk="Microsoft.NET.Sdk">
  <!-- POST-migration state: Microsoft's app-modernization tooling collapsed the
       Xamarin.Forms solution into a single MAUI head project, but left the Forms-flavoured
       Scandit *.Xamarin.Forms packages in place and never added the *.Maui companions. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.example.myscanapp</ApplicationId>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Scandit.DataCapture.Core.Xamarin.Forms" Version="6.28.3" />
    <PackageReference Include="Scandit.DataCapture.Barcode.Xamarin.Forms" Version="6.28.3" />
  </ItemGroup>
</Project>
