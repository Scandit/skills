  "es_module_shims_version": "2.6.2",
  "links": {
    "cdn_warning": "https://docs.scandit.com/sdks/web/add-sdk/#install-via-cdn",
    "complete_cdn_example": "https://docs.scandit.com/sdks/web/add-sdk/#complete-cdn-example",
    "multithreading": "https://docs.scandit.com/sdks/web/matrixscan/get-started/#improve-runtime-performance-by-enabling-browser-multithreading",
